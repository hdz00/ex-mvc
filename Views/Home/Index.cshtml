@model teste.Models.HomeViewModel

@{
    ViewData["Title"]="Home";
}

<main class="container text-center mt-5">

    <h1>Bem-vindo</h1>

    <p class="lead">
        Lorem ipsum dolor sit amet consectetur adipiscing elit.
    </p>

    <button id="Botao" class="btn btn-primary">
        clique aqui
    </button>

    <p id="mensagem" class="mt-3"></p>

    <hr />

    <h2 class="mt-4">Promoção</h2>

    <div class="card p-3 mb-4">

        <h3>@Model.Promocao.Nome</h3>

        <p>@Model.Promocao.Descricao</p>

        <p>
            <strong>desconto</strong>
            @Model.Promocao.Desconto%
        </p>

    </div>

    <hr />

    <h2 class="mt-4">Pesquisar serviços</h2>

    <form method="get" class="mb-4">

        <input
            type="text"
            name="termo"
            value="@Model.Termo"
            placeholder="Pesquisar..."
            class="form-control mb-3"
        />

        <button type="submit" class="btn btn-primary">
            Filtrar
        </button>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">
            Limpar
        </a>

    </form>

    <hr />

    <h2 class="mt-4">serviços</h2>

    <div class="row mt-3">

        @if (Model.Servicos.Count > 0)
        {
            @foreach (var servico in Model.Servicos)
            {
                <div class="col-md-4 mb-3">

                    <div class="card p-3">

                        <h3>@servico.Nome</h3>

                        <p>@servico.Descricao</p>

                        <p>
                            <strong>preço</strong>
                            @servico.Preco.ToString("C")
                        </p>

                    </div>

                </div>
            }
        }
        else
        {
            <p>Não foram encontrados serviços</p>
        }

    </div>

</main>